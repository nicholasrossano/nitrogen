  "description": "10k SHS; PV kWh displacement mode; displaced_ef in tCO2/kWh; year-1 annual ER",
  "source": "hand_calculation_solar_home_pv_kwh",
  "source_type": "validated_independent",
  "methodology_notes": {
    "headline_metric": "net_er_tco2e is year-1 annual tCO2e",
    "displacement_mode": "pv_kwh",
    "formula": "kwh_per_system = Wp × peak_sun_hours × 365 × system_efficiency / 1000; net_er = num_systems × kwh_per_system × displaced_ef_tco2_per_kwh × usage_rate",
    "leakage": "leakage_factor set to 0"
  },
  "adapter_input": {
