      "system_capacity_wp": 50,
      "peak_sun_hours": 4.5,
      "system_efficiency": 0.70,
      "displaced_ef_tco2_per_kwh": 0.001,
      "usage_rate": 1.0,
      "leakage_factor": 0,
      "crediting_period_years": 10
    }
  },
  "expect": {
    "computable": true,
    "result": {
      "baseline_emissions_tco2e": { "value": 574.875, "pct_tolerance": 0.00001 },
